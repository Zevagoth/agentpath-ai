# ============================================================================
# AgentPath AI overrides for RAGFlow's docker/.env
# ============================================================================
#
# scripts/bootstrap_ragflow.sh concatenates RAGFlow's shipped docker/.env with
# this file, so every upstream variable keeps a value (Compose interpolates the
# whole compose model, including services in inactive profiles) and the keys
# below win because a later definition of the same key overrides an earlier one.
#
# Placeholders of the form __AGENTPATH_*__ are substituted from .env.local,
# which holds generated secrets and is gitignored. This file never contains a
# real credential.
# ============================================================================

# --- pinned versions --------------------------------------------------------
RAGFLOW_IMAGE=infiniflow/ragflow:v0.27.2
STACK_VERSION=8.11.3

# --- engine selection -------------------------------------------------------
# Elasticsearch, not Infinity: we need real BM25 term scoring alongside kNN and
# highlight support for citation snippets.
DOC_ENGINE=elasticsearch
DB_TYPE=mysql
METADATA_DB_PROFILE=mysql
# DeepDoc OCR and layout analysis run on CPU for the search slice. The GPU is
# reserved for the Stage 2 chat model.
DEVICE=cpu
COMPOSE_PROFILES=elasticsearch,cpu,metadata-mysql
# Pure Python deployment: no Go services, so NATS and ClickHouse stay down.
API_PROXY_SCHEME=python

# --- resources --------------------------------------------------------------
# 4 GiB for Elasticsearch. The corpus is tiny; the rest of RAM belongs to the
# reranker sidecar and the desktop.
MEM_LIMIT=4294967296
TZ=__AGENTPATH_TZ__

# --- published ports: loopback only -----------------------------------------
# Each value carries the bind address, so Compose renders "127.0.0.1:8081:80"
# and nothing is reachable from the LAN. Verified by scripts/ragflow_health.sh.
# 8080 is occupied on the development host, hence 8081 for the RAGFlow UI.
SVR_WEB_HTTP_PORT=127.0.0.1:8081
SVR_WEB_HTTPS_PORT=127.0.0.1:8444
SVR_HTTP_PORT=127.0.0.1:9380
ADMIN_SVR_HTTP_PORT=127.0.0.1:9381
SVR_MCP_PORT=127.0.0.1:9382
GO_HTTP_PORT=127.0.0.1:9384
GO_ADMIN_PORT=127.0.0.1:9383
ES_PORT=127.0.0.1:1200
EXPOSE_MYSQL_PORT=127.0.0.1:3307
MINIO_PORT=127.0.0.1:9000
MINIO_CONSOLE_PORT=127.0.0.1:9001
REDIS_PORT=127.0.0.1:6379

# --- credentials (substituted from .env.local) ------------------------------
# RAGFlow ships the same default password everywhere; none of those defaults
# survive here.
MYSQL_PASSWORD=__AGENTPATH_MYSQL_PASSWORD__
MINIO_PASSWORD=__AGENTPATH_MINIO_PASSWORD__
REDIS_PASSWORD=__AGENTPATH_REDIS_PASSWORD__
ELASTIC_PASSWORD=__AGENTPATH_ELASTIC_PASSWORD__
ADMIN_DEFAULT_PASSWORD=__AGENTPATH_ADMIN_PASSWORD__

# --- registration -----------------------------------------------------------
# Needed once to create the local operator account. Set both to 0 afterwards;
# scripts/ragflow_health.sh reports when they are still open.
REGISTER_ENABLED=1
ENABLE_REGISTER=1

# --- AgentPath model sidecars ------------------------------------------------
# Consumed by infra/ragflow/docker-compose.override.agentpath.yml.
# Both run on CPU inside RAGFlow's network, so nothing crosses the host firewall
# and the GPU stays free for Stage 2 answer generation.
# Embedder: CPU. A single query embeds in a few hundred milliseconds, which the
# latency budget absorbs, and keeping it off the GPU leaves VRAM for Stage 2.
AGENTPATH_EMBEDDER_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.8
AGENTPATH_EMBEDDER_MODEL=BAAI/bge-m3
AGENTPATH_EMBEDDER_PORT=127.0.0.1:7998

# Reranker: GPU. Measured on this host: CPU reranking of ~30 candidates took
# 20-22 s per query, against 0.17-0.36 s for hybrid retrieval alone. The tag
# suffix is the CUDA compute capability (89 = Ada Lovelace = RTX 4060).
AGENTPATH_RERANKER_IMAGE=ghcr.io/huggingface/text-embeddings-inference:89-1.8
AGENTPATH_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
AGENTPATH_RERANKER_PORT=127.0.0.1:7997
