# AgentPath AI - example configuration
#
# Copy to .env.local and fill in real values:
#     cp .env.example .env.local
#
# .env.local is gitignored and is the ONLY place real secrets belong.
# Never commit a filled-in copy of this file. No value here is a real credential.

# --------------------------------------------------------------------------- #
# AgentPath API (apps/api)
# --------------------------------------------------------------------------- #
# Loopback only. This proof of concept has no authentication layer, so the API
# must never be bound to a routable interface.
AGENTPATH_API_HOST=127.0.0.1
AGENTPATH_API_PORT=8000
AGENTPATH_LOG_LEVEL=INFO
# Log the raw user query text. Off by default: queries can contain case details.
AGENTPATH_LOG_QUERY_TEXT=false

# --------------------------------------------------------------------------- #
# RAGFlow (document parsing, hybrid retrieval, citations)
# --------------------------------------------------------------------------- #
RAGFLOW_BASE_URL=http://127.0.0.1:9380
# Generated in the RAGFlow UI (top-right avatar > API). Put the real key in .env.local.
RAGFLOW_API_KEY=ragflow-REPLACE-ME
RAGFLOW_DATASET_NAME=agentpath-northwind-procedures
# model_name@provider, as registered inside RAGFlow.
# RAGFlow resolves model references as {model}@{instance}@{provider}.
RAGFLOW_EMBEDDING_MODEL=BAAI/bge-m3@agentpath-embedder@HuggingFace
RAGFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3@agentpath-reranker@HuggingFace
# Hybrid search weighting: vector share of the score. Term (BM25) share is 1 - x.
# Tuned against evaluation/queries.yaml; see EVALUATION.md for the rationale.
RAGFLOW_VECTOR_SIMILARITY_WEIGHT=0.6
RAGFLOW_SIMILARITY_THRESHOLD=0.15
# Candidates handed to the cross-encoder reranker. Higher = better ranking, slower.
RAGFLOW_RERANK_CANDIDATES=32
RAGFLOW_PAGE_SIZE=12
# Feature flag for cross-encoder reranking. Off by default: the only working
# runtime on the reference machine is CPU, where reranking measured 20-22 s per
# query against ~0.2 s for hybrid retrieval alone. Turn on once a GPU runtime
# works; the benchmark measures both paths either way.
AGENTPATH_ENABLE_RERANK=false
RAGFLOW_TIMEOUT_SECONDS=30
# RAGFlow's `keyword` flag does not switch on lexical matching (BM25 term scoring
# is always active, weighted by 1 - vector weight). It asks a chat model to
# extract keywords, costing an LLM round trip per search. AgentPath expands
# deterministically from data/synthetic/lexicon.yaml instead, so leave this off.
RAGFLOW_LLM_KEYWORD_EXPANSION=false

# --------------------------------------------------------------------------- #
# Model sidecars (CPU, inside RAGFlow's Docker network)
# --------------------------------------------------------------------------- #
# Both are Text Embeddings Inference containers on RAGFlow's own network.
# RAGFlow addresses them by service name (http://agentpath-embedder:80 and
# http://agentpath-reranker:80); the loopback addresses below exist so the host
# can verify them. Running them inside the network avoids opening any host port
# to Docker, which matters because ufw drops bridge-to-host traffic by default.
EMBEDDER_URL=http://127.0.0.1:7998
EMBEDDER_MODEL=BAAI/bge-m3
RERANKER_URL=http://127.0.0.1:7997
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --------------------------------------------------------------------------- #
# Ollama (Stage 2 answer generation only)
# --------------------------------------------------------------------------- #
# Called from the API process over loopback, so the daemon stays bound to
# 127.0.0.1 and needs no container-network access at all. Ollama runs natively on
# the host rather than in Docker, which is why the chat model gets the GPU while
# the reranker is stuck on CPU: 34/34 layers offload.
OLLAMA_HOST_URL=http://127.0.0.1:11434
# Chosen in T7 on measured evidence, not on release date. `make model-check`
# re-runs the acceptance harness (schema compliance, citation validity,
# unsupported claims, Arabic and English faithfulness, latency, VRAM, injection).
OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=120
# Context window. The model advertises 262144; we ask for 8192 deliberately. The
# KV cache is allocated when the model loads, not when a long prompt arrives, so
# an unused window is VRAM spent for nothing on an 8 GB card. Measured at 8192:
# 256 MiB of KV cache, 34/34 layers on the GPU.
OLLAMA_NUM_CTX=8192
# Greedy and seeded. A grounded answer that changes between two identical
# requests cannot be regression-tested.
OLLAMA_TEMPERATURE=0.0
OLLAMA_SEED=20260301
# A ceiling, not a target: without it a generation that goes wrong runs to the
# context limit instead of failing visibly.
OLLAMA_NUM_PREDICT=1536
# qwen3.5:4b advertises a "thinking" capability and thinks by default. Measured
# on the reference host: with thinking left on, the token budget was spent
# entirely on reasoning and the answer content came back EMPTY. Keep this false.
OLLAMA_THINK=false
# How long Ollama holds the weights in VRAM after a request. Ollama's own
# default; not raised, because on an 8 GB card the desktop compositor is a
# co-tenant and pinning 3 GB indefinitely is the wrong trade here.
OLLAMA_KEEP_ALIVE=5m

# --------------------------------------------------------------------------- #
# Web app (apps/web)
# --------------------------------------------------------------------------- #
NEXT_PUBLIC_AGENTPATH_API_URL=http://127.0.0.1:8000

# --------------------------------------------------------------------------- #
# Browser automation (Playwright, screenshot generation)
# --------------------------------------------------------------------------- #
# Optional. Absolute path to a chromium-family browser already installed on this
# machine (chromium, google-chrome, brave, microsoft-edge, vivaldi, ...). Set it
# and apps/web/playwright.config.ts launches that binary instead of the 173.7 MiB
# build `playwright install chromium` downloads. Leave it unset to keep the
# download-based default. The path is machine-specific, so it belongs in
# .env.local or the shell, never in a committed file.
# Run `make browser-check` to see which browser is resolved and why.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# --------------------------------------------------------------------------- #
# RAGFlow infrastructure passwords
# --------------------------------------------------------------------------- #
# scripts/bootstrap_ragflow.sh generates strong random values into .env.local
# with `openssl rand -hex 32`. The placeholders below are deliberately invalid;
# RAGFlow's shipped defaults (infini_rag_flow) are never reused.
RAGFLOW_MYSQL_PASSWORD=REPLACE-ME-GENERATED
RAGFLOW_MINIO_PASSWORD=REPLACE-ME-GENERATED
RAGFLOW_REDIS_PASSWORD=REPLACE-ME-GENERATED
RAGFLOW_ELASTIC_PASSWORD=REPLACE-ME-GENERATED
RAGFLOW_ADMIN_PASSWORD=REPLACE-ME-GENERATED
